# Kairos environment configuration
# Copy this file to .env and fill in your values.

# --- Gemini (required for AI mode; app works in offline mode without it) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Calendar backend ---
# "mock" uses demo data (default when token.json doesn't exist)
# "google" uses real Google Calendar (requires credentials.json + /auth/google)
# Leave blank to auto-detect (google if token.json exists, else mock)
CALENDAR_BACKEND=

# --- Google Calendar ---
# Calendar ID to read/write. NEVER use "primary" for seeding.
# Get this from Google Calendar Settings → Integrate calendar → Calendar ID
GOOGLE_CALENDAR_ID=primary

# --- Behavior ---
# Set to "true" to send calendar invites to attendees when creating/updating events
SEND_INVITES=false
